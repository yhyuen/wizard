; Engine configuration file.
; Open this folder in Godot 4.7 (standard edition), or export it for the web.

config_version=5

[application]

config/name="Wizard Prototype"
config/description="Wizard vertical slice: days 1 to 7 of the looping month and the Long Night, in the browser."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Progression="*res://scripts/autoload/progression.gd"
Run="*res://scripts/game/run.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
; A slow frame runs at most 3 rule ticks to catch up, so a slow browser slows the game down
; instead of falling further behind.
common/max_physics_steps_per_frame=3

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.06, 1)
